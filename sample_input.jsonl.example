{"id": "example_001", "task_instruction": "You are an expert annotator for a Text-to-NoSQL error taxonomy. Identify the single primary error in the generated query.", "natural_language_query": "In which years were cars produced weighing at least 3000?", "db_schema": {"collections": {"cars_data": {"fields": {"Year": "number", "Weight": "number"}}}}, "gold_nosql_query": "db.cars_data.aggregate([{ \"$match\": { \"Weight\": { \"$gte\": 3000 } } }, { \"$group\": { \"_id\": \"$Year\" } }])", "generated_nosql_query": "db.cars_data.aggregate([{ \"$match\": { \"Weight\": { \"$greaterThanOrEqual\": 3000 } } }, { \"$group\": { \"_id\": \"$Year\" } }])", "execution_error_message": "MongoServerError[BadValue]: unknown operator: $greaterThanOrEqual"}
